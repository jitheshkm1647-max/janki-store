# ---------------------------------------------------------------------------
# Janki Design storefront (Next.js) - copy to .env.local
# ---------------------------------------------------------------------------

# Filled in automatically by `npm run storefront:key` (repo root)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region (India)
NEXT_PUBLIC_DEFAULT_REGION=in

# Public URL of this storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Cashfree checkout mode: "sandbox" while testing, "production" when live.
# Must match CASHFREE_ENVIRONMENT in the backend.
NEXT_PUBLIC_CASHFREE_MODE=sandbox

NODE_ENV=development
