# ---------------------------------------------------------------------------
# Janki Design backend (Medusa) - copy to .env and fill in
# ---------------------------------------------------------------------------

# PostgreSQL and Redis (these match docker-compose.yml for local development)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/janki
REDIS_URL=redis://localhost:6379

# Public URLs
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000

# CORS: which sites may call the API
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Secrets. Use long random values in production:
#   openssl rand -hex 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Cashfree Payments (https://merchant.cashfree.com > Developers > API keys)
# Leave blank to run with Cash on Delivery only.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# "sandbox" while testing, "production" when live
CASHFREE_ENVIRONMENT=sandbox

# Product images: leave blank to store uploads on local disk (./static).
# Set these to use S3, Cloudflare R2 or DigitalOcean Spaces in production.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# "shared" runs API and background jobs together. In production you can run
# one "server" instance and one "worker" instance.
MEDUSA_WORKER_MODE=shared
